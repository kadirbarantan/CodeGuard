# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env GitHub'a gönderilmez (.gitignore).

# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth App'teki "Authorization callback URL" ile birebir aynı olmalı
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Adımlar: docs/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İstemcideki "Authorized redirect URIs" ile birebir aynı olmalı
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend adresi (CORS ve pencere mesajı yalnızca bu adrese gider)
FRONTEND_URL=http://localhost:5173

# Oturum token'ı imza anahtarı. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_SURE_GUN=7
