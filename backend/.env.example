# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env GitHub'a gönderilmez (.gitignore).

# ESKİ: OAuth App ile giriş. 27.11.2026'dan beri site GitHub girişini de aşağıdaki GitHub App ile yapıyor; boş kalabilir.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth App'teki "Authorization callback URL" ile birebir aynı olmalı
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# GitHub App: GitHub ile giriş + repo erişimi (GitHub sekmesi). Adımlar: docs/github-app.md
# Her geliştirici kendi App'ini oluşturur. App ID, slug ve Client ID gizli değildir; client secret gizlidir.
GITHUB_APP_ID=
# App adresindeki kısa ad: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# İndirilen .pem dosyasının yolu. Repo klasörünün DIŞINDA tut; Windows'ta da / kullan (ör. D:/codeguard-gizli/app.pem)
GITHUB_APP_PRIVATE_KEY_PATH=
# App'teki "Callback URL" ile birebir aynı olmalı
GITHUB_APP_REDIRECT_URI=http://localhost:8000/auth/github-app/callback

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Adımlar: docs/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İstemcideki "Authorized redirect URIs" ile birebir aynı olmalı
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Veritabanı (docker-compose.yml'deki kullanıcı adı / şifre / veritabanı adıyla aynı)
DATABASE_URL=postgresql+psycopg://codeguard:codeguard@localhost:5432/codeguard

# Yüklenen kodların saklandığı klasör (boş bırakılırsa backend/yuklemeler). GitHub'a gönderilmez.
YUKLEME_KLASORU=

# Sahte motor (geçici): canlı akışta iki adım arası bekleme, saniye
SAHTE_MOTOR_ADIM_SN=1.3

# Frontend adresi (CORS ve pencere mesajı yalnızca bu adrese gider)
FRONTEND_URL=http://localhost:5173

# Oturum token'ı imza anahtarı. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_SURE_GUN=7

# Test motoru, birim ajanı (Faz 4). Anahtar: Google AI Studio > Get API key. Gizlidir; sohbete ya da koda yazılmaz.
GEMINI_API_KEY=
# Model. Ücretsiz katmanda Flash-Lite'ın günlük kotası daha geniş; ölçüm için gemini-3.8-flash denenebilir.
GEMINI_MODEL=gemini-3.5-flash-lite
# Dakikadaki en fazla istek (ücretsiz katman sınırının altında kal; gemini-3.8-flash için 5)
GEMINI_DAKIKA_ISTEK=10
# Düşünme düzeyi: boş = modelin varsayılanı; low / medium / high
GEMINI_DUSUNME=
# Çalıştırma başına token tavanı ve en fazla tur (K6)
AJAN_TOKEN_TAVANI=200000
AJAN_EN_FAZLA_TUR=4
